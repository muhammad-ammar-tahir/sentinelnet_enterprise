# Model files — exclude raw training artefacts, whitelist production models
*.pkl
!ai_models/trained_model.pkl
!ai_models/supervised_model.pkl
!ai_models/scaler.pkl

# Git history — not needed in image
.git
.gitignore

# Docs / scripts — not needed at runtime
docs/
tests/
scripts/demo.py
README.md
*.md

# IDE
.vscode/
.idea/
