# Node
node_modules
frontend/node_modules
frontend/dist

# Python
.venv
venv
__pycache__
*.pyc
*.pyo
*.pyd

# Environment secrets — never bake into image
.env
.env.local
.env.*.local

# Logs & test artefacts
*.log
.pytest_cache
htmlcov
.coverage

