# =============================================================================
# SentinelNet — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
APP_NAME=SentinelNet
ENVIRONMENT=development                # development | staging | production
DEBUG=true
LOG_LEVEL=INFO                        # DEBUG | INFO | WARNING | ERROR

# -----------------------------------------------------------------------------
# SECURITY
# -----------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-256-bit-secret-key
JWT_ALGORITHM=HS256
SERVICE_API_KEY=sentinelnet-internal-service-key-2026
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Default admin user (created on first startup via seed_db.py)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@university.edu
ADMIN_PASSWORD=change-me-on-first-login

# -----------------------------------------------------------------------------
# DATABASE — PostgreSQL
# -----------------------------------------------------------------------------
# Must use postgresql+asyncpg:// for async driver (backend)
DATABASE_URL=postgresql+asyncpg://sentinelnet:sentinelpass@localhost:5432/sentinelnet

# Individual components (used by Docker Compose)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sentinelnet
POSTGRES_USER=sentinelnet
POSTGRES_PASSWORD=sentinelpass

# SQLAlchemy connection pool
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false                         # Set true to log all SQL (verbose)

# -----------------------------------------------------------------------------
# CACHE / QUEUE — Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=                        # Leave blank if no auth

# Channel names (do not change without updating code)
REDIS_INCIDENT_CHANNEL=sentinelnet:incidents
REDIS_METRICS_CHANNEL=sentinelnet:metrics
REDIS_TOPOLOGY_CHANNEL=sentinelnet:topology

# -----------------------------------------------------------------------------
# RYU SDN CONTROLLER
# -----------------------------------------------------------------------------
RYU_BASE_URL=http://localhost:8080     # Ryu WSGI REST API base URL
RYU_OFPORT=6653                        # OpenFlow TCP listen port
RYU_TOPOLOGY_API=/v1.0/topology
RYU_STATS_API=/stats
RYU_API_TIMEOUT=10                    # seconds before marking Ryu unreachable

# -----------------------------------------------------------------------------
# PROMETHEUS
# -----------------------------------------------------------------------------
PROMETHEUS_URL=http://localhost:9090
PROMETHEUS_SCRAPE_INTERVAL=10         # seconds (must match prometheus.yml)

# Ryu exporter (Ryu's built-in Prometheus endpoint)
RYU_EXPORTER_PORT=8080
RYU_EXPORTER_PATH=/metrics

# Custom host exporter
HOST_EXPORTER_PORT=9100

# -----------------------------------------------------------------------------
# AI / ML MODULES
# -----------------------------------------------------------------------------
# Anomaly Detection
ANOMALY_MODEL_PATH=backend/ai/models/anomaly_detector.pkl
ANOMALY_THRESHOLD=0.65                # Isolation Forest score cutoff (0–1)
VOTING_WINDOW=5                       # Number of recent samples to vote on
VOTING_MIN_COUNT=3                    # Minimum anomalous votes to trigger

# Failure Diagnosis
DIAGNOSER_MODEL_PATH=backend/ai/models/failure_diagnoser.pkl
DIAGNOSER_MIN_CONFIDENCE=0.50        # Below this → flag for manual review

# Recovery Recommendation
RECOMMENDER_MODEL_PATH=backend/ai/models/recovery_recommender.pkl
RECOMMENDER_KNN_K=5                  # Number of nearest neighbors

# Model Retraining
RETRAINING_BUFFER_THRESHOLD=50       # Trigger retraining after N new samples
RETRAINING_MIN_F1=0.75               # Reject new model if F1 < this

# -----------------------------------------------------------------------------
# MONITORING PIPELINE
# -----------------------------------------------------------------------------
SCRAPE_INTERVAL_SEC=10               # How often to fetch metrics from Prometheus
RECOVERY_VERIFY_DELAY_SEC=30         # Wait time before verifying recovery
RECOVERY_TIMEOUT_SEC=15              # Max time for a recovery action before timeout
MAX_RECOVERY_RETRIES=2               # Retry attempts before escalation

# -----------------------------------------------------------------------------
# ALERTS & NOTIFICATIONS
# -----------------------------------------------------------------------------
ALERT_ENABLED=true

# Slack (optional)
SLACK_WEBHOOK_URL=                    # https://hooks.slack.com/services/...
SLACK_CHANNEL=#network-alerts

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=sentinelnet@university.edu
ALERT_EMAIL_TO=noc@university.edu

# Webhook (generic POST on escalation)
ESCALATION_WEBHOOK_URL=              # POST to this URL when incident escalates

# -----------------------------------------------------------------------------
# FRONTEND (Vite build-time variables — prefix VITE_)
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api
VITE_WS_URL=ws://localhost:8000/ws
VITE_APP_TITLE=SentinelNet
VITE_REFRESH_INTERVAL_MS=5000        # Topology/metrics poll interval

# -----------------------------------------------------------------------------
# DOCKER (used by docker-compose.yml)
# -----------------------------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
BACKEND_PORT=8000
FRONTEND_PORT=5173

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
